{#- RWKV7 G1 chat template: "System: / User: / Assistant:" turns separated by a blank line, as in the GGUF's own
    template, but thinking is on by default ("Assistant: <think>") and enable_thinking=false gives the fake think
    "Assistant: <think></think>" (the answer right away). Blank lines inside a message become single newlines (a blank
    line ends a turn for RWKV). Earlier answers render without their thinking; an assistant message after the last user
    message keeps its reasoning_content, so that llama-server can continue it. -#}
{%- set ns = namespace(last_user=-1) %}
{%- for message in messages %}
{%- if message['role'] == 'user' %}
{%- set ns.last_user = loop.index0 %}
{%- endif %}
{%- endfor %}
{{- bos_token }}
{%- for message in messages %}
{%- set content = message['content'] if message['content'] is string else '' %}
{%- if message['role'] == 'assistant' and '</think>' in content %}
{%- set content = content.split('</think>')[-1] %}
{%- endif %}
{%- set content = content | trim | replace('\r\n', '\n') | replace('\n\n\n\n', '\n') | replace('\n\n\n', '\n') | replace('\n\n', '\n') | replace('\n\n', '\n') %}
{%- if message['role'] == 'system' %}
{{- 'System: ' + content + '\n\n' }}
{%- elif message['role'] == 'user' %}
{{- 'User: ' + content + '\n\n' }}
{%- elif message['role'] == 'assistant' %}
{%- if loop.index0 > ns.last_user and message.reasoning_content is defined and message.reasoning_content %}
{{- 'Assistant: <think>\n' + message.reasoning_content | trim + '\n</think>\n' + content + '\n\n' }}
{%- else %}
{{- 'Assistant: ' + content + '\n\n' }}
{%- endif %}
{%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
{%- if enable_thinking is defined and enable_thinking is false %}
{{- 'Assistant: <think></think>' }}
{%- else %}
{{- 'Assistant: <think>' }}
{%- endif %}
{%- endif %}
