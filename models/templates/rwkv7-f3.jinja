{#- RWKV7 compact tag format (F3, pilot). Every tag is one token: the RWKV vocab's rarely used control-byte tokens,
    renamed in the GGUF (runs/rwkv/fmt/make_f3_gguf.py):
      <|system|> <|user|> <|assistant|> <|tool|> <|end|>    CONTROL (never printed); <|end|> = end of turn
      <think> </think> <tool_call> </tool_call>             USER_DEFINED (printed, so the reasoning/tool parsers see them)
    No newlines around tags: special tokens never merge with text. Tools are listed as TypeScript-like signatures.

      <|system|>{system}\n\n# Tools\nname(arg: type, opt?: type) - description\n...<|end|>
      <|user|>{content}<|end|>
      <|assistant|><think>{reasoning}</think>{answer}<|end|>
      <|assistant|><think>...</think><tool_call>{"name": "f", "arguments": {...}}</tool_call><|end|>
      <|tool|>{result}<|end|>                                (one turn per tool message, in order)

    Thinking off: the generation prompt "<|assistant|><think></think>". Earlier answers render without their thinking;
    assistant messages after the last user message keep reasoning_content (agent loops). -#}
{%- macro clean(s) -%}
{{- (s if s is string else '') | replace('\r\n', '\n') | replace('<|', '< |') | replace('<think>', '< think>') | replace('</think>', '< /think>') | replace('<tool_call>', '< tool_call>') | replace('</tool_call>', '< /tool_call>') | trim -}}
{%- endmacro -%}
{%- macro ts_type(s) -%}
{%- if s is not mapping -%}any
{%- elif s.enum is defined and s.enum is iterable and s.enum is not string -%}
{%- for e in s.enum -%}{{- e | tojson -}}{%- if not loop.last %}{{- ' | ' }}{%- endif -%}{%- endfor -%}
{%- elif s.type is defined and s.type == 'object' and s.properties is defined and s.properties is mapping -%}
{{- '{' -}}{{- ts_params(s) -}}{{- '}' -}}
{%- elif s.type is defined and s.type == 'array' -%}
{{- (ts_type(s['items']) if s['items'] is defined else 'any') + '[]' -}}
{%- elif s.type is defined and s.type is string -%}{{- s.type -}}
{%- else -%}any
{%- endif -%}
{%- endmacro -%}
{%- macro ts_params(s) -%}
{%- set req = s.required if s.required is defined and s.required is iterable and s.required is not string else [] -%}
{%- for k, v in s.properties.items() -%}
{{- k + ('' if k in req else '?') + ': ' + ts_type(v) -}}
{%- if v is mapping and v.description is defined and v.description -%}{{- ' /* ' + (v.description | string | trim) + ' */' -}}{%- endif -%}
{%- if v is mapping and v.default is defined -%}{{- ' = ' + (v.default | tojson) -}}{%- endif -%}
{%- if not loop.last %}{{- ', ' }}{%- endif -%}
{%- endfor -%}
{%- endmacro -%}
{%- macro tool_sig(t) -%}
{%- set f = t.function if t.function is defined else t -%}
{%- set p = f.parameters if f.parameters is defined and f.parameters is mapping else {} -%}
{{- f.name + '(' + (ts_params(p) if p.properties is defined and p.properties is mapping else '') + ')' -}}
{%- if f.description is defined and f.description -%}{{- ' - ' + (f.description | string | trim) -}}{%- endif -%}
{%- endmacro -%}
{%- macro tool_calls_block(message) -%}
{%- for tc in message.tool_calls -%}
{%- set f = tc.function if tc.function is defined else tc -%}
{%- set args = f.arguments if f.arguments is defined else {} -%}
{{- '<tool_call>{"name": ' + (f.name | tojson) + ', "arguments": ' + (args if args is string else (args | tojson)) + '}</tool_call>' -}}
{%- endfor -%}
{%- endmacro -%}
{%- set ns = namespace(last_user=-1) %}
{%- set has_tools = tools is defined and tools is not none and tools | length > 0 %}
{%- for message in messages %}
{%- if message['role'] == 'user' %}
{%- set ns.last_user = loop.index0 %}
{%- endif %}
{%- endfor %}
{%- set tools_text -%}
{%- if has_tools -%}
{{- '# Tools\n' -}}
{%- for tool in tools -%}
{{- tool_sig(tool) + '\n' -}}
{%- endfor -%}
{{- 'Call: <tool_call>{"name": ..., "arguments": {...}}</tool_call>' -}}
{%- endif -%}
{%- endset %}
{%- set sys_first = messages | length > 0 and messages[0]['role'] == 'system' %}
{%- if has_tools or sys_first %}
{%- set sys_content = clean(messages[0]['content']) if sys_first else '' %}
{{- '<|system|>' + sys_content + ('\n\n' if sys_content and has_tools else '') + tools_text + '<|end|>' }}
{%- endif %}
{%- for message in messages %}
{%- if loop.first and sys_first %}
{%- elif message['role'] == 'system' %}
{{- '<|system|>' + clean(message['content']) + '<|end|>' }}
{%- elif message['role'] == 'user' %}
{{- '<|user|>' + clean(message['content']) + '<|end|>' }}
{%- elif message['role'] == 'assistant' %}
{%- set content = message['content'] if message['content'] is string else '' %}
{%- if '</think>' in content %}
{%- set content = content.split('</think>')[-1] %}
{%- endif %}
{%- set content = clean(content) %}
{%- set has_calls = message.tool_calls is defined and message.tool_calls is not none and message.tool_calls | length > 0 %}
{%- set body = content + (tool_calls_block(message) if has_calls else '') %}
{%- if loop.index0 > ns.last_user and message.reasoning_content is defined and message.reasoning_content %}
{{- '<|assistant|><think>' + message.reasoning_content | trim + '</think>' + body + '<|end|>' }}
{%- else %}
{{- '<|assistant|>' + body + '<|end|>' }}
{%- endif %}
{%- elif message['role'] == 'tool' %}
{{- '<|tool|>' + clean(message['content']) + '<|end|>' }}
{%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
{%- if enable_thinking is defined and enable_thinking is false %}
{{- '<|assistant|><think></think>' }}
{%- else %}
{{- '<|assistant|><think>' }}
{%- endif %}
{%- endif %}
